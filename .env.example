# ==============================================================================
# Mailflare Mobile - Environment Configuration (.env)
# ==============================================================================
# Copy this file to `.env` in your project root for local development:
#   cp .env.example .env
#
# Replace the URL below with your deployed Mailflare backend Worker / Cloudflare URL.
# If left empty or unset, the app will display a setup screen on first launch
# prompting the user to enter their custom Mailflare server address.
# ==============================================================================

EXPO_PUBLIC_MAILFLARE_API_URL="https://your-mailflare-instance.workers.dev"
