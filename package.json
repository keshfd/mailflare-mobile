  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "axios": "^1.20.0",
    "expo": "~57.0.20",
    "expo-constants": "^57.0.17",
    "expo-device": "^57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-linking": "~57.0.9",
    "expo-notifications": "^57.0.17",
    "expo-secure-store": "^57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.41.0",
    "react": "19.2.3",
    "react-error-boundary": "^6.1.5",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:android:local": "npx eas-cli build --platform android --profile development --local",
    "build:ios:local": "npx eas-cli build --platform ios --profile development --local",
    "build:all:local": "npx eas-cli build --platform all --profile development --local",
    "build:android": "npx eas-cli build --platform android --profile preview",
    "build:ios": "npx eas-cli build --platform ios --profile preview",
    "build:all": "npx eas-cli build --platform all --profile preview",
    "build:android:prod": "npx eas-cli build --platform android --profile production",
    "build:ios:prod": "npx eas-cli build --platform ios --profile production",
    "build:all:prod": "npx eas-cli build --platform all --profile production",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --profile production",
    "submit:all": "npx eas-cli submit --platform all --profile production"
  },
  "private": true
}
